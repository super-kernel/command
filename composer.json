{
    "name": "super-kernel/command",
    "description": "The command component for super-kernel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "super-kernel",
        "command"
    ],
    "homepage": "https://github.com/super-kernel/command",
    "support": {
        "issues": "https://github.com/super-kernel/command/issues",
        "source": "https://github.com/super-kernel/command"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Command\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernelTest\\Command\\": "tests/src/"
        }
    },
    "config": {
        "classmap-authoritative": true,
        "optimize-autoloader": true,
        "sort‑packages": true
    },
    "minimum-stability": "dev",
    "require": {
        "php": "~8.4.0",
        "super-kernel/attribute": "dev-main",
        "super-kernel/contract": "dev-main"
    },
    "require-dev": {
        "super-kernel/framework": "dev-main"
    }
}
